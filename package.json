{
  "name": "exfish",
  "private": true,
  "version": "1.02.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npx vercel --prod --yes",
    "deploy:vercel": "vercel --prod",
    "cap:build": "npm run build && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "build:apk": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleRelease && cd ..",
    "publish:apk": "npm run build:apk && git add public/exfish.apk && git commit -m \"chore(release): auto-publish updated apk to homepage\" && git push origin main",
    "build:release": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleRelease && .\\gradlew.bat bundleRelease && cd ..",
    "sync:apk": "cd android && .\\gradlew.bat copyReleaseApkToWeb && cd ..",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "@types/d3-contour": "^3.0.6",
    "clsx": "^2.1.1",
    "d3-contour": "^4.0.2",
    "exif-js": "^2.3.0",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-kakao-maps-sdk": "^1.2.2",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "suncalc": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "potrace": "^2.1.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
