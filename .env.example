# ExFish Environment Variables
# Copy to .env.local for local development

# Data mode: 'local' (0 Supabase requests), 'cdn' (Vercel Edge CDN default), 'supabase' (direct)
VITE_DATA_MODE=cdn

# Optional override for API base URL (empty for same-origin web, https://exfish.vercel.app for Capacitor Android)
VITE_API_BASE_URL=

# Supabase (public anon client for legacy/fallback writes)
VITE_SUPABASE_URL=https://johtqemdlprtbpohdkgu.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-only secrets (set in Vercel Dashboard, NEVER prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=
# Optional VWorld WMTS API key (empty uses public xdworld.vworld.kr tile service)
VWORLD_API_KEY=

# Optional Google Maps JavaScript API Key (for Google Maps provider & Places search)
VITE_GOOGLE_MAPS_API_KEY=
